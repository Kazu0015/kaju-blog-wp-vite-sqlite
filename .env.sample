# =============================================================================
# deploy-rsync.sh（ローカルから rsync するとき）
# =============================================================================
# cp .env.sample .env のあと、実値に書き換えてください（.env は gitignore 対象）

# 本番サーバーのユーザー・ホスト・デプロイ先ディレクトリ（1 行）
DEPLOY_TARGET=root@133.18.121.105:/home/kazu/docker_doc/kaju_blog
# SSH/rsync 用の秘密鍵パス（ssh_connect.sh の -i と同じ）
DEPLOY_SSH_KEY=$HOME/.ssh/kagoya_20251117144716.key
# 任意: リモートへ .env.prod として送るローカルファイル
# DEPLOY_ENV_FILE=.env.prod
# 任意: テーマ自動有効化をスキップ
# SKIP_THEME_ACTIVATE=1
# 任意: WordPress コンテナ名（既定: kaju_blog_wordpress_prod）
# DEPLOY_WP_CONTAINER=kaju_blog_wordpress_prod
# 初回・復旧: ローカル SQLite + uploads を本番に上書き（本番 DB は消えます）
# DEPLOY_SYNC_DATABASE=1
# DEPLOY_URL_FROM=http://localhost:8080
# DEPLOY_URL_TO=https://kaju-blog.webcerto.net


# =============================================================================
# 本番（docker-compose.prod.yml + Traefik）
# =============================================================================
# 使い方の例:
#   cp .env.sample .env.prod
#   # DOMAIN / WP_HOME を編集後
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Traefik の Host() に使うホスト名（証明書の SAN と一致させる。プロトコルなし）
DOMAIN=kaju-blog.webcerto.net

# WordPress のサイト URL（プロトコル＋ドメイン。末尾スラッシュなし）
WP_HOME=https://kaju-blog.webcerto.net

# Traefik と共有する Docker 外部ネットワーク名（ホストの traefik と同じ名前）
TRAEFIK_NETWORK=traefik-network

# =============================================================================
# 開発（docker-compose.dev.yml）
# =============================================================================
# 現状の dev 用 compose は環境変数を参照していません。
# ローカルで Vite 開発サーバのオリジンを固定したい場合は wp-config.php の KAJU_BLOG_VITE_ORIGIN を参照してください。

DEPLOY_ENV_FILE=.env.prod
