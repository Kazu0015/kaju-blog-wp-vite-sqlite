{
  "name": "kaju-blog-playwright",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright test",
    "test:headed": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright test --headed",
    "test:mp4": "npm test && npm run export:mp4",
    "export:mp4": "bash scripts/export-mp4.sh",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
